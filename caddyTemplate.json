        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              { "email": "ZWEI_BLOG_EMAIL", "module": "acme" },
              { "module": "zerossl" }
            ],
            "on_demand": true
          }
        ],
        "on_demand": {
          "permission": {
            "module": "http",
            "endpoint": "http://127.0.0.1:3000/api/admin/caddy/ask"
          }
        }
      }
    }
  }
