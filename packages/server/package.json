{
  "name": "@zweiblog/server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:noweb": "ZWEIBLOG_DISABLE_WEBSITE=true nest start",
    "dev": "nest start --watch",
    "dev:noweb": "ZWEIBLOG_DISABLE_WEBSITE=true nest start --watch",
    "start:dev": "nest start --watch",
    "start:dev:noweb": "ZWEIBLOG_DISABLE_WEBSITE=true nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.18",
    "@nestjs/core": "11.1.18",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/mongoose": "11.0.0",
    "@nestjs/passport": "11.0.2",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/schedule": "5.0.0",
    "@nestjs/swagger": "11.4.7",
    "@types/line-reader": "^0.0.34",
    "@types/request-ip": "^0.0.37",
    "axios": "^1.20.0",
    "cheerio": "1.0.0-rc.12",
    "compressing": "^2.1.3",
    "dayjs": "^1.11.10",
    "express": "5.2.1",
    "feed": "^4.2.2",
    "highlight.js": "^11.9.0",
    "ip2region-ts": "2.0.1",
    "js-base64": "^3.7.5",
    "js-sha256": "^0.9.0",
    "line-reader": "^0.4.0",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.1",
    "markdown-it-task-lists": "^2.1.1",
    "mongodb": "^5.9.2",
    "mongoose": "^7.8.12",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "picgo": "^3.0.2",
    "pino": "^8.21.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^4.4.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "sitemap": "^7.1.1",
    "ua-parser-js": "1.0.41",
    "yaml": "^2.9.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.1.18",
    "@types/express": "5.0.6",
    "@types/jest": "29.4.1",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.1",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^2.0.16",
    "@types/ua-parser-js": "0.7.39",
    "jest": "29.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "29.4.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "4.1.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
