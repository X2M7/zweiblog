      "braces@3": "3.0.3",
      "cipher-base": "1.0.5",
      "cross-spawn@6": "6.0.6",
      "cross-spawn@7": "7.0.6",
      "dompurify": "3.4.14",
      "ejs": "3.1.10",
      "elliptic": "6.6.1",
