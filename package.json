{
  "name": "zweiblog",
  "version": "1.0.2",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf packages/*/node_modules && rm -rf packages/*/dist",
    "build": "pnpm --filter @zweiblog/server --filter @zweiblog/theme-default --filter @zweiblog/admin --parallel build",
    "build:admin": "pnpm --filter @zweiblog/admin build",
    "build:server": "pnpm --filter @zweiblog/server build",
    "build:website": "pnpm --filter @zweiblog/theme-default build",
    "dev": "pnpm --filter @zweiblog/server --filter @zweiblog/admin --parallel dev",
    "dev:server": "pnpm --filter @zweiblog/server dev:noweb ",
    "dev:website": "pnpm --filter @zweiblog/theme-default dev",
    "dev:admin": "pnpm --filter @zweiblog/admin dev",
    "docs:build": "pnpm run -r docs:build",
    "docs:dev": "pnpm run -r docs:dev",
    "kill": "sudo bash scripts/kill-all.sh",
    "release": "standard-version",
    "release-note": "node scripts/releaseNote.js",
    "release-major": "standard-version --release-as major",
    "release-minor": "standard-version --release-as minor",
    "release-patch": "standard-version --release-as patch"
  },
  "packageManager": "pnpm@8.11.0",
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@babel/helpers": "7.29.7",
