# Copy this file to .env. It intentionally contains no credentials.
# Generate MongoDB credentials with setup-mongo-secrets.sh or
# setup-mongo-secrets.ps1; never add the generated secrets directory to Git.

ZWEIBLOG_IMAGE=ghcr.io/x2m7/zweiblog:latest
# Keep this distinct from any legacy VanBlog Compose project on the same host.
COMPOSE_PROJECT_NAME=zweiblog
ZWEIBLOG_MONGO_VERSION=8.0
TZ=Asia/Shanghai

# Safe HTTP-only defaults for Nginx/Caddy running on the same host.
ZWEIBLOG_HTTP_BIND=127.0.0.1
ZWEIBLOG_HTTP_PORT=8080

# The base Compose file disables bundled TLS and does not publish port 443.
# These values are used only with docker-compose.https.yml.
ZWEIBLOG_HTTPS_BIND=127.0.0.1
ZWEIBLOG_HTTPS_PORT=8443
ACME_EMAIL=

# Keep loopback unless an outer proxy is present. Add only that proxy's exact
# IP/CIDR; never use 0.0.0.0/0. Example: loopback,172.18.0.1/32
ZWEI_BLOG_TRUST_PROXY=loopback
# Set the same outer proxy range here without the `loopback,` alias. The image
# validates every comma-separated IP/CIDR before starting its bundled Caddy.
ZWEI_BLOG_CADDY_TRUSTED_PROXIES=

# Relative paths are resolved from this docker-compose directory.
ZWEIBLOG_DATA_DIR=.
ZWEIBLOG_WEB_NETWORK=zweiblog-web

# Unsafe runtime features stay disabled unless explicitly accepted.
ZWEI_BLOG_ENABLE_SWAGGER=false
ZWEI_BLOG_ALLOW_TRUSTED_CUSTOM_CODE=false
ZWEI_BLOG_PIPELINE_ALLOW_UNSAFE_EXECUTION=false
ZWEI_BLOG_PICGO_ALLOW_UNSAFE_PLUGIN_INSTALL=false

# Docker json-file log rotation.
ZWEIBLOG_LOG_MAX_SIZE=10m
ZWEIBLOG_LOG_MAX_FILES=3
